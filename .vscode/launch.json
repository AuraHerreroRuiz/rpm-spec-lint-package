  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "python",
      "request": "launch",
      "preLaunchTask": "Build test tar",
      "program": "src/main.py",
      "console": "internalConsole",
      "env": {
        "GITHUB_WORKSPACE": "./",
        "INPUT_SPEC_FILE": "test/test.spec",
        "INPUT_SOURCES_DIR": "test/SOURCES"
      }
    }
  ]
}
