{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Prepare debug tar and github_output",
			"type": "shell",
			"icon": {
				"id": "beaker"
			},
			"command": "mkdir -p ${workspaceFolder}/.tmp && echo -n '' > ${workspaceFolder}/.tmp/github_output && cd test && tar -cf SOURCES/test-rpm.tar test-rpm.c"
		},
		{
			"label": "Show action output",
			"type": "shell",
			"icon": {
				"id": "output"
			},
			"command": "code -g ${workspaceFolder}/.tmp/github_output"
		}
	]
}
